<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Fullscreen Property Image / Video Background -->
    <ImageView
        android:id="@+id/img_property_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"
        tools:src="@drawable/placeholder" />

    <!-- Dark Gradient Overlay for High Contrast Text Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_bottom" />

    <!-- Top Subtle Dark Overlay for Toolbar Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_top" />

    <!-- Media Type Indicator Badge (Video / Photo) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="125dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_rounded_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_listing_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="FOR SALE • COMMERCIAL"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- RIGHT VERTICAL ACTION BAR (TikTok Style Stack) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="36dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Agent Avatar -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_agent_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/white"
                app:strokeWidth="2dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|center_horizontal"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/primary_brown" />

        </FrameLayout>

        <!-- ENQUIRE BUTTON (Primary Highlighted CTA) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_action_enquire"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="@color/primary_brown"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/white" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Enquire"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- FAVORITE BUTTON -->
        <ImageView
            android:id="@+id/btn_action_favorite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/btn_star_big_off"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_favorite_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <!-- SHARE BUTTON -->
        <ImageView
            android:id="@+id/btn_action_share"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_share"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Share"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <!-- VIEW DETAILS BUTTON -->
        <ImageView
            android:id="@+id/btn_action_details"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Details"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/btn_action_flag"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Report listing"
            android:src="@drawable/ic_flag"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Flag"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- BOTTOM LEFT PROPERTY INFO OVERLAY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="90dp"
        android:layout_marginStart="20dp"
        android:orientation="vertical">

        <!-- Agent Name & Verified Tag -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_agent_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Space &amp; Occupy"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="VERIFIED AGENT"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Property Title -->
        <TextView
            android:id="@+id/tv_property_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="1½ Acres Commercial Land &amp; Hotel"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Price Display -->
        <TextView
            android:id="@+id/tv_property_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="KSh 35,000,000"
            android:textColor="#FFB74D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Location -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_dialog_map"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_property_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Maragua, Murang'a County, Kenya"
                android:textColor="@color/white"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Description Summary -->
        <TextView
            android:id="@+id/tv_property_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Prime commercial land with hotel development in Maragua. Ideal for hospitality, resort, or commercial project."
            android:textColor="#E0E0E0"
            android:textSize="12sp" />

        <!-- Quick Specs Chips -->
        <TextView
            android:id="@+id/tv_property_specs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1.5 Acres • Title Deed Ready • Utilities Connected"
            android:textColor="#FFCC80"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
