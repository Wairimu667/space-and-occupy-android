<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <!-- VERTICAL SWIPE VIEWPAGER FOR TIKTOK-STYLE PROPERTY FEED -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_tiktok"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <!-- TOP OVERLAY HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingHorizontal="16dp">

        <!-- Header Row: Logo, Title, and Portal Login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="32dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo_brand" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="SPACE &amp; OCCUPY"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Agent / Admin Portal Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_portal_login"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Agent/Admin"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="#80000000"
                app:cornerRadius="19dp"
                app:icon="@android:drawable/ic_menu_myplaces"
                app:iconTint="@color/white"
                app:strokeColor="#60FFFFFF"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- Category Horizontal Filter Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:checked="true"
                    android:text="All Feeds"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#80000000"
                    app:chipStrokeColor="#80FFFFFF"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_for_sale"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="For Sale"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#80000000"
                    app:chipStrokeColor="#80FFFFFF"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_for_rent"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Rentals"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#80000000"
                    app:chipStrokeColor="#80FFFFFF"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_land"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Land &amp; Plots"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#80000000"
                    app:chipStrokeColor="#80FFFFFF"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_commercial"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Commercial"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#80000000"
                    app:chipStrokeColor="#80FFFFFF"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

    </LinearLayout>

</FrameLayout>
