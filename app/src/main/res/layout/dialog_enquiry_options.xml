<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle drag indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D0D0D0" />

    <TextView
        android:id="@+id/tv_enquiry_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enquire About Property"
        android:textColor="@color/deep_brown"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_enquiry_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Speak directly with the Space &amp; Occupy listing agent"
        android:textColor="@color/grey"
        android:textSize="13sp" />

    <!-- Property Card Preview inside Bottom Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/light_cream"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_color"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_sheet_property"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sheet_property_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Property Title"
                    android:textColor="@color/deep_brown"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sheet_property_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KSh 0"
                    android:textColor="@color/primary_brown"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sheet_property_agent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listing Agent: Space &amp; Occupy"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ACTION 1: WHATSAPP DIRECT -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_enquire_whatsapp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="Chat on WhatsApp (+254 787 900284)"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="#25D366"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_send"
        app:iconTint="@color/white" />

    <!-- ACTION 2: DIRECT CALL -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_enquire_call"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Call Agent Direct"
        android:textColor="@color/primary_brown"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_call"
        app:iconTint="@color/primary_brown"
        app:strokeColor="@color/primary_brown" />

    <!-- ACTION 3: IN-APP INQUIRY / SCHEDULE VISIT -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_enquire_in_app"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Schedule Physical Site Visit"
        android:textColor="@color/dark_brown"
        android:textSize="14sp" />

</LinearLayout>
