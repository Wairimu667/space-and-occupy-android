<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/deep_brown">

    <TextView
        android:id="@+id/tv_ad_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPONSORED ADVERTISEMENT"
        android:textColor="#E0701B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tv_ad_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Space &amp; Occupy Premier Listings"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/img_ad_banner"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_logo_brand"
        android:background="#22000000" />

    <TextView
        android:id="@+id/tv_ad_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Explore verified commercial properties, luxury villas, and prime plots in Kenya with zero commission markup."
        android:textColor="#D5C2B5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_ad_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ad playing... (15s remaining)"
        android:textColor="#F57C00"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip_ad"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="Skip Ad (15s)"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary_brown"
        app:cornerRadius="12dp" />

</LinearLayout>
