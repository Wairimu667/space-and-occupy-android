<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter Properties"
        android:textColor="@color/deep_brown"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Listing Type Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Listing Type"
        android:textColor="@color/deep_brown"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_listing_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_listing_all"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="All Listings"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/chip_stroke" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_listing_sale"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="For Sale"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/chip_stroke" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_listing_rent"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="For Rent"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/chip_stroke" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_listing_lease"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lease"
            app:chipBackgroundColor="@color/chip_background"
            app:chipStrokeColor="@color/chip_stroke" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Max Price Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Max Budget / Price Limit"
        android:textColor="@color/deep_brown"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_max_price"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Maximum Price ($)"
        app:boxStrokeColor="@color/primary_brown">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_max_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/brand_black" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_filter"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Reset Filters"
            android:textColor="@color/primary_brown"
            app:strokeColor="@color/border_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_filter"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Apply Filters"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary_brown" />

    </LinearLayout>

</LinearLayout>
