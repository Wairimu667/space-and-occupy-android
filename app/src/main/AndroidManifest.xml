<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpaceAndOccupy">

        <!-- Launcher Router -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SpaceAndOccupy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Flow -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.PendingAgentActivity"
            android:exported="false" />

        <!-- Role Dashboards -->
        <activity
            android:name=".client.ClientHomeActivity"
            android:exported="false" />

        <activity
            android:name=".agent.AgentHomeActivity"
            android:exported="false" />

        <activity
            android:name=".admin.AdminHomeActivity"
            android:exported="false" />

        <!-- Client Portal & Property Exploration -->
        <activity
            android:name=".client.PropertyListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".client.PropertyDetailActivity"
            android:exported="false" />

        <activity
            android:name=".client.SavedFavoritesActivity"
            android:exported="false" />

        <activity
            android:name=".client.MyInquiriesAndVisitsActivity"
            android:exported="false" />

        <!-- Agent Portal -->
        <activity
            android:name=".agent.AddPropertyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".agent.ManageAgentListingsActivity"
            android:exported="false" />

        <activity
            android:name=".agent.AgentInquiriesActivity"
            android:exported="false" />

        <!-- Admin Portal -->
        <activity
            android:name=".admin.AgentVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".admin.ListingModerationActivity"
            android:exported="false" />

        <activity
            android:name=".admin.ManageAllPropertiesActivity"
            android:exported="false" />

    </application>

</manifest>